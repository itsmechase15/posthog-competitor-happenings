# Required for a real run
DATABASE_URL=
CURSOR_API_KEY=

# Opens the issue each Slack message links to. Actions provides this for free;
# locally, a PAT with repo scope. Unset skips issue creation.
GITHUB_TOKEN=
GITHUB_REPOSITORY=itsmechase15/posthog-competitor-happenings

# Slack delivery. The bot token wins when both are set.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0C07A1DM09
# Optional fallback if you would rather not create a Slack app
SLACK_WEBHOOK_URL=

# Optional sources — each one is skipped with a log line when unset
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=chasemccaskill@agentmail.to
X_BEARER_TOKEN=

# Print the Slack payloads instead of posting, and skip all database writes
DRY_RUN=false
# Analyze the first-run backlog instead of recording it silently. Dry runs only.
FORCE_ANALYZE=false

# Tuning (defaults shown)
# CURSOR_MODEL=claude-opus-5
# CURSOR_RUNTIME=local
# LOOKBACK_DAYS=7
# MAX_ITEMS_PER_RUN=12
# MAX_ITEMS_PER_SOURCE=8
# POSTHOG_MAX_PAGES=60
# POSTHOG_REFRESH_DAYS=14
# SKIP_POSTHOG_INDEX=false
# HTTP_TIMEOUT_MS=20000
# LOG_LEVEL=info
# Screenshot renderers, tried in order. {encodedUrl} is the one that keeps an
# anchor, which is how a changelog entry on a shared page gets its own picture.
# SCREENSHOT_URL_TEMPLATE=https://api.microlink.io/?url={encodedUrl}&screenshot=true&meta=false&embed=screenshot.url,https://image.thum.io/get/width/1200/crop/900/noanimate/{url}
