# Every variable this app reads, with where the value comes from.
#
# This file is the shape, never the values. Copy it to .env for a local run –
# git ignores .env – and put the real values in the repo's Actions secrets for
# the daily job. `npm run check-env -- --strict` tells you what is still missing.
#
# Required for a real run
# ---------------------------------------------------------------------------

# Postgres that remembers what has already been posted.
    10|# Supabase → Project Settings → Database → Connection string → Session pooler.
# It has to be the pooler URI: the direct db.<ref>.supabase.co host is IPv6 only
# and GitHub's runners have no IPv6 route, so a direct URI works on a laptop and
# fails on every scheduled run.
DATABASE_URL=

# Runs the Opus analysis that turns a launch into recommended actions.
# cursor.com/dashboard → Integrations → API Keys → Create key.
# Unset falls back to restating the source, labeled "not model-analyzed".
CURSOR_API_KEY=
    20|
# Posts the alert. api.slack.com/apps → your app → OAuth & Permissions → add the
# chat:write bot scope → install to the workspace → copy the xoxb- token. Then
# invite the app to the channel with /invite @your-app, or every post is
# not_in_channel. Reinstalling issues a new token, so update this when you do.
SLACK_BOT_TOKEN=
# The channel it posts to – yours, not a default. In Slack: channel → View
# channel details → the C0… id at the bottom. Shaped like C0ABC123DEF. Nothing
# is delivered through the bot token until this is set; the app will not guess.
SLACK_CHANNEL_ID=
# Optional fallback for a workspace where creating an app is not worth it. The
# bot token wins when both are set, and a webhook cannot say why Slack refused.
    30|SLACK_WEBHOOK_URL=

# Sources – each one is skipped, with a log line, when its key is unset
# ---------------------------------------------------------------------------

# The last few posts from @mixpanel and @Amplitude_HQ.
# developer.x.com → Projects & Apps → your app → Keys and tokens → Bearer Token.
X_BEARER_TOKEN=

# The inbox the competitors' newsletters are delivered to.
    40|# agentmail.to → dashboard → API keys, then create an inbox and subscribe it to
# the Mixpanel and Amplitude newsletters. README → "Newsletters" has the steps.
AGENTMAIL_API_KEY=
# The address of that inbox – yours, not a default. Shaped like
# name@agentmail.to. Unset skips the newsletter source instead of reading
# somebody else's inbox.
AGENTMAIL_INBOX_ID=

# GitHub issues – one per recommended action, linked from the Slack message
# ---------------------------------------------------------------------------

# Actions provides this for free and the workflows grant it issues: write.
    50|# Locally, a PAT with repo scope. Unset skips issue creation and still posts.
GITHUB_TOKEN=
# owner/repo the issues are filed against. Actions sets this to the running
# repo, so a fork files its own issues without any change here.
GITHUB_REPOSITORY=itsmechase15/posthog-competitor-happenings

# Run modes
# ---------------------------------------------------------------------------

# Print the Slack payloads instead of posting, and skip all database writes
    60|DRY_RUN=false
# Analyze the first-run backlog instead of recording it silently. Dry runs only.
FORCE_ANALYZE=false

# The review pass (defaults shown)
# ---------------------------------------------------------------------------
# Once an action's issue is open, a second model reads the same docs corpus and
# says agree, revise, or drop. A revise is rewritten by the analyst's model and
# then put back through the same evidence checks in code; a rewrite that fails
# them is thrown away and the original issue stands. It runs once per action.

# The reviewer. A different model from the analyst on purpose: the model that
# wrote a confident wrong claim is the worst judge of it. A model id your API key
# cannot run skips the review and labels the issue review:skipped.
# REVIEW_MODEL=claude-fable-5-1
# The model that applies a revise. Defaults to CURSOR_MODEL.
# UPDATER_MODEL=claude-opus-5
# Turn the review off for a fast local run. The daily job leaves this unset.
# SKIP_REVIEW=false
# Reviews allowed in one run. Past it, an action is filed as written and
# labelled review:skipped.
# REVIEW_MAX_PER_RUN=12

# Tuning (defaults shown)
# ---------------------------------------------------------------------------
# CURSOR_MODEL=claude-opus-5
# CURSOR_RUNTIME=local
# LOOKBACK_DAYS=7
# MAX_ITEMS_PER_RUN=12
    70|# MAX_ITEMS_PER_SOURCE=8
# HTTP_TIMEOUT_MS=20000
# LOG_LEVEL=info
# USER_AGENT=posthog-competitor-happenings/0.1 (+https://github.com/PostHog/marketing)
# Screenshot renderers, tried in order. {encodedUrl} is the one that keeps an
# anchor, which is how a changelog entry on a shared page gets its own picture.
# SCREENSHOT_URL_TEMPLATE=https://api.microlink.io/?url={encodedUrl}&screenshot=true&meta=false&embed=screenshot.url,https://image.thum.io/get/width/1200/crop/900/noanimate/{url}

# The docs corpus (defaults shown)
# ---------------------------------------------------------------------------
# The `pages` table is what this bot knows about PostHog, and these settings
# decide what goes in it and how current it is kept. Nothing here is a secret.

# Pages read in one run. Discovery lands around 6,600, and the default clears
# that with room: the coverage gate is only as good as the corpus behind it,
# and a partial corpus blocks honest recommendations and misses wrong ones.
# POSTHOG_MAX_PAGES=8000
# Re-read a page this many days after the last read. The cold tier.
# POSTHOG_REFRESH_DAYS=14
# The same, for a page an analyst has read lately. Those are the pages
# recommendations rest on, so they are kept closer to current.
# DOCS_HOT_REFRESH_DAYS=3
# Skip the corpus refresh entirely, for a fast local run against what is stored.
# SKIP_POSTHOG_INDEX=false
# Where discovery starts. One input among several, never the whole truth.
# DOCS_SITEMAPS=https://posthog.com/sitemap/sitemap-0.xml
# DOCS_LLMS_TXT=https://posthog.com/llms.txt
# PostHog's own changelog. Its entries are evidence that something shipped and
# none at all that it is documented.
# POSTHOG_CHANGELOG_INDEX=https://posthog.com/changelog
# A one-off seed for an empty corpus, read once and never again. posthog.com
# publishes no llms-full.txt today, so this is unset and the first run fills
# the corpus a page at a time.
# DOCS_LLMS_FULL_TXT=
# How many pages are read at once. Small on purpose: this is somebody else's
# website, and the point is to stop being needlessly slow, not to crawl hard.
# DOCS_FETCH_CONCURRENCY=6
# Where the per-run markdown copy of the corpus is written for the analyst to
# search. Rebuilt every run; git ignores it.
# DOCS_WORKSPACE_DIR=.docs-workspace
# How many corpus excerpts are pre-loaded into the prompt, and how many of
# them may come from any one section of the docs.
# RETRIEVAL_TOP_K=10
# RETRIEVAL_PER_SECTION=4
